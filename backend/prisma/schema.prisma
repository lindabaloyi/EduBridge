generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── School ─────────────────────────────────────────────────
model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  students  Student[]
  teachers  Teacher[]
  parents   Parent[]
  classes   Class[]
  subjects  Subject[]
  academicYears AcademicYear[]
  assessments Assessment[]
  announcements Announcement[]
  messages Message[]
}

// ── User ───────────────────────────────────────────────────
enum UserRole {
  ADMIN
  PRINCIPAL
  TEACHER
  PARENT
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentsCreated   Assessment[] @relation("AssessmentCreated")
  assessmentsModerated Assessment[] @relation("AssessmentModeration")
}

// ── Student ────────────────────────────────────────────────
model Student {
  id            String   @id @default(cuid())
  studentNo     String
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  gender        String?
  guardianName  String?
  guardianPhone String?
  attendance    Float? // percentage 0–100
  averageGrade  String?

  classId    String?
  class      Class?    @relation(fields: [classId], references: [id])
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])

  parentId String?
  parent   Parent?   @relation(fields: [parentId], references: [id])

  marks StudentMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentNo])
}

// ── Teacher ────────────────────────────────────────────────
model Teacher {
  id         String   @id @default(cuid())
  employeeNo String
  firstName  String
  lastName   String
  email      String?

  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, employeeNo])
}

// ── Parent ─────────────────────────────────────────────────
model Parent {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  students Student[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Class ──────────────────────────────────────────────────
model Class {
  id        String   @id @default(cuid())
  name      String
  grade     String?

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  students  Student[]
  assessments Assessment[]
  announcements Announcement[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Subject ────────────────────────────────────────────────
model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
}

// ── Academic Year ──────────────────────────────────────────
model AcademicYear {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms Term[]
}

// ── Term ───────────────────────────────────────────────────
model Term {
  id             String   @id @default(cuid())
  label          String
  startDate      DateTime
  endDate        DateTime
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AssessmentType {
  ASSIGNMENT
  TEST
  EXAM
  PROJECT
  CLASSWORK
  PRACTICAL
  ORAL
  OTHER
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  SUBMITTED_FOR_MODERATION
  MODERATED
  LOCKED
}

enum MarkStatus {
  GRADED
  MISSING
  ABSENT
}

model Assessment {
  id        String   @id @default(cuid())
  name      String
  type      AssessmentType
  date      DateTime
  maxMark   Float
  weight    Float
  description String?

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  termId    String
  term      Term     @relation(fields: [termId], references: [id])

  status AssessmentStatus @default(DRAFT)

  createdById   String?
  createdBy     User?    @relation("AssessmentCreated", fields: [createdById], references: [id])
  moderatedById String?
  moderatedBy   User?    @relation("AssessmentModeration", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?
  moderationNote String?

  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])

  marks StudentMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([termId, subjectId, classId, name])
}

model StudentMark {
  id           String   @id @default(cuid())
  mark         Float?
  status       MarkStatus @default(GRADED)
  editedAt     DateTime?

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
}
// ── Communication ─────────────────────────────────────────
enum CommsKind {
  ANNOUNCEMENT
  NOTICE
}

enum Audience {
  EVERYONE
  STAFF
  PARENTS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum MessageKind {
  INTERNAL
  PARENT
}

enum SenderType {
  TEACHER
  SCHOOL
  PARENT
}

model Announcement {
  id      String    @id @default(cuid())
  kind    CommsKind @default(ANNOUNCEMENT)
  title   String
  body    String
  audience Audience @default(EVERYONE)
  pinned  Boolean   @default(false)
  status  AnnouncementStatus @default(DRAFT)

  classId   String?
  class     Class?    @relation(fields: [classId], references: [id])
  createdById String?
  publishedAt DateTime?

  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id])
  kind      MessageKind @default(PARENT)

  subject String
  body    String

  senderType SenderType @default(TEACHER)
  senderId   String?
  senderName String

  toParentId  String?
  toParent    Parent?  @relation(fields: [toParentId], references: [id])
  toClassId   String?
  toClass     Class?   @relation(fields: [toClassId], references: [id])
  toUserId    String?

  replyToId String?
  readAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}